menu "PID Controller Configuration"

    # ──────────────────────────────────────────────────────────────────
    # All three gains (Kp, Ki, Kd) are stored as integer thousandths so
    # menuconfig only deals with whole numbers. The PID component divides
    # by 1000 at startup. Examples:
    #     value 300 -> coefficient 0.300
    #     value  20 -> coefficient 0.020
    #     value   5 -> coefficient 0.005
    #
    # Output limits stay as plain percent (value 0..100 = 0..100 % duty).
    # ──────────────────────────────────────────────────────────────────

    config PID_KP
        int "Kp - Proportional gain (thousandths; 300 = 0.300)"
        default 115
        range 0 1000
        help
            Proportional gain, stored as Kp x 1000. Example: 300 = Kp 0.300.

            FORMULA
              P_term = Kp * (setpoint - measured)

            INTUITION
              "How hard the controller pushes the heater RIGHT NOW based on
              how far off we are." It's a spring: the further you stretch
              it (= bigger error), the harder it pulls back.

            CONCRETE EXAMPLE (Kp = 0.300, output_max = 1.00)
              error =  1 C  -> P_term = 0.30  -> 30 % power
              error =  3 C  -> P_term = 0.90  -> 90 % power
              error =  5 C  -> P_term = 1.50  -> clamped to 100 % power
              error = 50 C  -> P_term = 15.0  -> clamped to 100 % power
              => Anything past ~3 C of lag saturates the heater. That is
                 EXPECTED on a cold-start; the saturation only matters once
                 you're near setpoint.

            IF YOU INCREASE Kp
              + Faster reaction to disturbances (door opens, load added).
              + Smaller steady-state offset while holding.
              - More tendency to overshoot the setpoint.
              - Eventually starts ringing/oscillating around setpoint.

            IF YOU DECREASE Kp
              + Smoother, calmer output.
              - Slower ramp tracking, the chamber lags the setpoint more.
              - Holds further below setpoint (needs higher Ki to compensate).

            CLASSIC SYMPTOMS
              Too low : "It just won't reach setpoint — sits 5 C low forever."
              Too high: "It overshoots by 20 C then keeps bouncing."

            TUNING TIP
              Standard recipe: with Ki = 0 and Kd = 0, raise Kp until the
              chamber oscillates around setpoint. Cut Kp by ~30 %. Now add
              Kd to brake overshoot, then small Ki to close the residual gap.
              Typical furnace range: 100 .. 500 (i.e. Kp 0.10 .. 0.50).

    config PID_KI
        int "Ki - Integral gain (thousandths; 20 = 0.020)"
        default 1
        range 0 1000
        help
            Integral gain, stored as Ki x 1000. Example: 20 = Ki 0.020.

            FORMULA
              I_term = Ki * sum_over_time( error * dt )

            INTUITION
              "Keep score of how long we've been off-target, and slowly
              add output to close any remaining gap." It's the only term
              that can drive STEADY-STATE error to zero.

            CONCRETE EXAMPLE (Ki = 0.020, dt = 1 s)
              error  1 C held for 60 s  -> integral = 60
                                        -> I_term = 0.020 * 60 = 1.20
                                        -> would saturate output 100 %
              error  0.5 C held for 60 s -> I_term = 0.60 -> 60 % power
              => Even a "small" Ki winds up substantial output over a minute.
                 Start small.

            IF YOU INCREASE Ki
              + Closes the residual offset (chamber holds AT setpoint, not
                "near it") much faster.
              - Tends to OVERSHOOT after a setpoint change because the
                integrator keeps winding past the goal.
              - Can cause slow oscillation (much slower than Kp oscillation).

            IF YOU DECREASE Ki
              + Cleaner step response, less overshoot.
              - Steady-state offset persists. You'll sit at e.g. 197 C
                instead of 200 C indefinitely.

            CLASSIC SYMPTOMS
              Too low : "Holds steady but 3 C below setpoint forever."
              Too high: "Reaches setpoint then floats up to setpoint+5 C
                         over the next 2 minutes before coming back."

            ANTI-WINDUP
              The code uses conditional integration: while the output is
              saturated AND the error would push it further into saturation,
              the integral is NOT advanced. So a long cold-start cannot make
              the integrator explode. You can run with non-zero Ki safely.

            TUNING TIP
              Add LAST. Get Kp and Kd doing useful work first, then add
              just enough Ki to eliminate the residual hold offset. If you
              see oscillation appear when you raise Ki, you're too high.
              Typical furnace range: 5 .. 30 (i.e. Ki 0.005 .. 0.030).

    config PID_KD
        int "Kd - Derivative gain (thousandths; 50 = 0.050)"
        default 0
        range 0 1000
        help
            Derivative gain, stored as Kd x 1000. Example: 50 = Kd 0.050.

            FORMULA  (derivative-on-measurement, not on error)
              D_term = -Kd * d(measured) / dt

            INTUITION
              "Look at how fast the chamber temperature is RISING right now.
              The faster it's rising, the harder we should brake — before
              the rise carries us past the setpoint." This is exactly the
              mechanism that catches the stored heat in glowing elements.

            WHY derivative-on-MEASUREMENT (not on error)
              If we did d(error)/dt, a sudden setpoint jump would generate
              a huge negative spike (error step = giant derivative). On
              measurement, we ignore setpoint jumps and only react to
              actual temperature movement. Much smoother.

            CONCRETE EXAMPLE (Kd = 0.050)
              Climbing 0.5 C/s  -> D_term = -0.025 -> subtracts 2.5 % power
              Climbing 1.0 C/s  -> D_term = -0.050 -> subtracts 5 % power
              Climbing 3.0 C/s  -> D_term = -0.150 -> subtracts 15 % power
              => The faster the chamber heats, the more aggressively the
                 PID pulls back. This activates BEFORE error reaches zero.

            IF YOU INCREASE Kd
              + Less overshoot at the top of fast ramps.
              + Earlier braking against thermal inertia.
              - Sensor noise (thermocouple jitter) gets amplified into
                output noise. Watch for the SSR clicking rapidly.

            IF YOU DECREASE Kd
              + Smoother output, less affected by sensor noise.
              - More overshoot when the chamber is rising fast and
                arriving at setpoint.

            CLASSIC SYMPTOMS
              Too low : "We always overshoot the top of a ramp by 10 C."
              Too high: "Output is jittery — power flickers between 40 %
                         and 60 % every second."

            TUNING TIP
              Useful range for a thermal-mass furnace: 20 .. 150
              (i.e. Kd 0.020 .. 0.150). If output gets jittery, halve it.
              If overshoot persists, double it. Goes well with a clean
              filtered thermocouple reading; if your sensor is noisy,
              keep Kd modest.

    config PID_OUTPUT_MIN
        int "Output minimum (% duty)"
        default 0
        range 0 100
        help
            Lower clamp on PID output, in PERCENT of full SSR duty.

            Almost always 0. Raise this only if you have a specific reason
            for the heater to remain partly on at all times (e.g. preventing
            element thermal cycling), which is unusual for a furnace.

    config PID_OUTPUT_MAX
        int "Output maximum (% duty)"
        default 100
        range 0 100
        help
            Upper clamp on PID output, in PERCENT of full SSR duty.

            100 % is the right default for healthy hardware: let the PID
            command everything available when it needs to. Cap below 100 %
            only for a deliberate physical reason (e.g. a damaged SSR or
            element you don't trust at full duty). Capping below what the
            PID actually wants will make the controller fall behind at
            high temperatures, because radiative loss grows fast with
            absolute temperature — at 400 C the chamber loses heat much
            faster than at 100 C, so the steady-state power needed to hold
            is much higher.

    config PID_ADAPTIVE_OUTPUT_LIMIT_ENABLED
        bool "Enable adaptive output limit near setpoint"
        default n
        help
            EXPERIMENTAL / OFF BY DEFAULT.

            When enabled, the upper output clamp shrinks as the chamber
            approaches setpoint (gain-scheduled by |error|). The idea is
            to prevent the elements from being driven hard right before
            you arrive, so the stored thermal energy can't push past the
            setpoint.

            This is NOT recommended for normal use. A well-tuned PID with
            non-zero Kd already brakes against incoming temperature rise
            via derivative-on-measurement. Only enable this if a single
            set of P/I/D gains genuinely cannot cover the full operating
            range — e.g. great control at 100 C, big overshoot at 400 C —
            and you need an extra clamp on top.

            When OFF (default), the static PID_OUTPUT_MAX is used at all
            times and the bands/factors below are ignored.

    config PID_ADAPTIVE_BAND_FAR_C
        int "Adaptive: full-power band threshold (deg C)"
        default 20
        range 1 500
        depends on PID_ADAPTIVE_OUTPUT_LIMIT_ENABLED
        help
            When |error| >= this many degrees C, the full configured
            PID_OUTPUT_MAX is allowed.

    config PID_ADAPTIVE_BAND_MID_C
        int "Adaptive: mid-band threshold (deg C)"
        default 10
        range 1 500
        depends on PID_ADAPTIVE_OUTPUT_LIMIT_ENABLED

    config PID_ADAPTIVE_BAND_NEAR_C
        int "Adaptive: near-band threshold (deg C)"
        default 5
        range 1 500
        depends on PID_ADAPTIVE_OUTPUT_LIMIT_ENABLED

    config PID_ADAPTIVE_BAND_CLOSE_C
        int "Adaptive: close-band threshold (deg C)"
        default 2
        range 1 500
        depends on PID_ADAPTIVE_OUTPUT_LIMIT_ENABLED

    config PID_ADAPTIVE_FACTOR_MID_PCT
        int "Adaptive: mid-band output factor (% of OUTPUT_MAX)"
        default 70
        range 0 100
        depends on PID_ADAPTIVE_OUTPUT_LIMIT_ENABLED

    config PID_ADAPTIVE_FACTOR_NEAR_PCT
        int "Adaptive: near-band output factor (% of OUTPUT_MAX)"
        default 40
        range 0 100
        depends on PID_ADAPTIVE_OUTPUT_LIMIT_ENABLED

    config PID_ADAPTIVE_FACTOR_CLOSE_PCT
        int "Adaptive: close-band output factor (% of OUTPUT_MAX)"
        default 25
        range 0 100
        depends on PID_ADAPTIVE_OUTPUT_LIMIT_ENABLED

    config PID_ADAPTIVE_FACTOR_HOLD_PCT
        int "Adaptive: hold-band output factor (% of OUTPUT_MAX)"
        default 15
        range 0 100
        depends on PID_ADAPTIVE_OUTPUT_LIMIT_ENABLED
        help
            When |error| is below all band thresholds (we're "on setpoint"),
            output is capped at this fraction of OUTPUT_MAX. Keep this
            non-zero so the controller can still supply enough heat to
            offset steady-state losses.
endmenu
